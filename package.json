{
  "name": "pi-codex-agents",
  "version": "1.0.1",
  "description": "Native Pi extension for persistent agent sessions and a session command center",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/extension.js",
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "docs/ARCHITECTURE.md",
    "docs/RELEASING.md",
    "docs/SECURITY-REVIEW.md",
    "scripts/prepare.mjs",
    "scripts/build.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-sessions.mjs && node scripts/smoke-host.mjs && node scripts/smoke-compat.mjs && python3 scripts/smoke-extension.py",
    "release:check": "npm run build && npm run typecheck && npm test && npm run smoke && npm run fresh-install",
    "fresh-install": "node scripts/fresh-install.mjs",
    "prepublishOnly": "npm run release:check && node scripts/publish-guard.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0 <1.4.0",
    "@earendil-works/pi-tui": ">=1.3.0 <1.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidstack/pi-codex-agents.git"
  },
  "homepage": "https://github.com/sidstack/pi-codex-agents#readme",
  "bugs": {
    "url": "https://github.com/sidstack/pi-codex-agents/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "agents",
    "sessions"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
