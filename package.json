{
  "name": "pi-codex-agents",
  "version": "1.3.0",
  "description": "Native Pi extension for persistent agent sessions and a session command center",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "dist/extension.js",
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "docs/ARCHITECTURE.md",
    "docs/RELEASING.md",
    "docs/SECURITY-REVIEW.md",
    "scripts/prepare.mjs",
    "scripts/build.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-sessions.mjs && node scripts/smoke-host.mjs && node scripts/smoke-compat.mjs && python3 scripts/smoke-extension.py && python3 scripts/smoke-launch.py",
    "release:check": "npm run build && npm run typecheck && npm test && npm run smoke && npm run fresh-install",
    "audit:ci": "audit-ci --config ./audit-ci.json",
    "fresh-install": "node scripts/fresh-install.mjs",
    "prepublishOnly": "node scripts/prepublish.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "22.19.19",
    "audit-ci": "7.1.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0 <1.5.0",
    "@earendil-works/pi-tui": ">=1.3.0 <1.5.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sidstack/pi-codex-agents.git"
  },
  "homepage": "https://github.com/sidstack/pi-codex-agents#readme",
  "bugs": {
    "url": "https://github.com/sidstack/pi-codex-agents/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "agents",
    "sessions"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
